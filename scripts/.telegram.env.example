# Plantilla del fichero de secretos que leen los scripts a través de telegram.sh.
# Se instala junto a los scripts con el nombre .telegram.env:
#
#   sudo cp .telegram.env.example .telegram.env
#   sudo chown root:root .telegram.env
#   sudo chmod 600 .telegram.env
#
# El fichero real nunca se sube al repositorio (.gitignore) ni se sincroniza
# con Syncthing (patrón /Scripts/.telegram.env en el .stignore).

# Token del bot, obtenido con @BotFather
TOKEN="PON_AQUI_EL_TOKEN_DEL_BOT"

# ID del chat que recibe los avisos
CHAT_ID="PON_AQUI_EL_CHAT_ID"
